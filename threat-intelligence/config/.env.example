# Threat Intelligence Platform - Environment Variables
# Do NOT hardcode actual API keys or credentials in any scripts or the repository.
# Copy this file to '.env' and populate with your own credentials.

# MISP API
MISP_URL="https://misp.example.com"
MISP_API_KEY="YOUR_MISP_API_KEY_HERE"
MISP_VERIFYCERT=False

# AlienVault OTX
OTX_API_KEY="YOUR_OTX_API_KEY_HERE"

# VirusTotal
VT_API_KEY="YOUR_VT_API_KEY_HERE"

# PostgreSQL (For IOC Storage)
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="ioc_db"
DB_USER="ioc_user"
DB_PASS="YOUR_DB_PASSWORD"
