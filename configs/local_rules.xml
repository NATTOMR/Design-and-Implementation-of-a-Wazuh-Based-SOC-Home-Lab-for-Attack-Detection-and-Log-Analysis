<!-- Custom Wazuh Detection Rules for SOC Home Lab -->
<group name="custom_rules,sysmon,windows,attack_detection">

  <!-- Rule 100001: Detect Suspicious PowerShell Execution -->
  <rule id="100001" level="10">
    <if_sid>61603,60000</if_sid>
    <field name="win.eventdata.image" type="s">powershell.exe</field>
    <description>SOC Lab: Suspicious PowerShell process execution detected on endpoint.</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- Rule 100002: Detect Nmap / Port Scan activity via Sysmon Network Connections -->
  <rule id="100002" level="8">
    <if_sid>61605</if_sid>
    <field name="win.eventdata.destinationPort" type="s">^4444$|^3389$|^22$</field>
    <description>SOC Lab: Suspicious network connection to sensitive port detected.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- Rule 100003: High Volume Failed Logins (Brute-force indicator) -->
  <rule id="100003" level="12" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <description>SOC Lab: Multiple failed Windows login attempts detected in 60 seconds (Possible Brute-Force Attack).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Rule 100004: Registry Run Key Modification (Persistence) -->
  <rule id="100004" level="10">
    <if_sid>61613,61614</if_sid>
    <field name="win.eventdata.targetObject" type="s">CurrentVersion\\Run</field>
    <description>SOC Lab: Registry persistence mechanism modified under Run key.</description>
    <mitre>
      <id>T1112</id>
    </mitre>
  </rule>

</group>
